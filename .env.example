# ============================================================
# Fluxiflow for Agency — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# .env is listed in .gitignore.
# ============================================================

# ── Django Core ─────────────────────────────────────────────
# Generate a secure key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-fluxiflow-for-agency-project-management-v1-key

# Set to False in production
DEBUG=True

# ── Database ─────────────────────────────────────────────────
# Development (leave empty → SQLite at backend/db.sqlite3)
DATABASE_URL=

# Production (PostgreSQL connection string):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# ── Hosts & CORS ─────────────────────────────────────────────
# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# Production example:
# ALLOWED_HOSTS=localhost,127.0.0.1,app.fluxiflow.com,api.fluxiflow.com

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production example:
# CORS_ALLOWED_ORIGINS=https://app.fluxiflow.com

# ── CSRF Trusted Origins ─────────────────────────────────────
# Required in production when Django is behind a reverse proxy / HTTPS.
# Must include the scheme (https://).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Production example:
# CSRF_TRUSTED_ORIGINS=https://app.fluxiflow.com,https://api.fluxiflow.com

# ── Frontend URL ─────────────────────────────────────────────
# Used in outbound invitation and OTP emails.
FRONTEND_URL=http://localhost:5173

# Production example:
# FRONTEND_URL=https://app.fluxiflow.com

# ── SSL (Production only, ignored when DEBUG=True) ───────────
# SECURE_SSL_REDIRECT=True

# ── Email / SMTP ─────────────────────────────────────────────
# Required for OTP login emails and team invitation emails.
# When EMAIL_HOST is not set, Django outputs emails to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=no-reply@fluxiflow.agency

# ── Google OAuth Configuration ──────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login

