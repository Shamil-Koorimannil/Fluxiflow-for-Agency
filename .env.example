# Django Secret Key (Generate a secure random string in production)
SECRET_KEY=django-insecure-fluxiflow-for-agency-project-management-v1-key

# Debug Mode (Set to False in production)
DEBUG=True

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
# If left empty, Django will fall back to local sqlite (db.sqlite3) in development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fluxiflow

# Allowed Hosts & CORS Origins (Comma-separated values)
ALLOWED_HOSTS=localhost,127.0.0.1,fluxiflow.agency
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://fluxiflow.agency

# SSL / Redirect settings (Production only)
SECURE_SSL_REDIRECT=True

# SMTP Email Settings (Required for actual OTP and invitation email delivery in production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@fluxiflow.agency
